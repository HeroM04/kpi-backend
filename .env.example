# ============================================================
# Copy file này thành .env rồi điền GIÁ TRỊ THẬT:
#       cp .env.example .env      (hoặc copy tay trên Windows)
#
# File .env đã được .gitignore — KHÔNG commit secret lên git.
# Dùng đúng bộ giá trị đang đặt trên Render (BE production).
# ============================================================

# --- Neon PostgreSQL ---
# Định dạng JDBC, nhớ thêm ?sslmode=require cho Neon:
DATABASE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
DB_USERNAME=<neon-username>
DB_PASSWORD=<neon-password>

# --- Bảo mật đăng nhập (BẮT BUỘC đổi trên production) ---
# Chuỗi ngẫu nhiên >= 32 ký tự dùng để ký token đăng nhập.
# Nếu lộ, kẻ xấu có thể giả mạo token của bất kỳ tài khoản nào.
# Tạo nhanh: openssl rand -base64 48
JWT_SECRET=<chuoi-ngau-nhien-dai-it-nhat-32-ky-tu>

# --- Cloudinary (lưu ảnh upload) ---
# Lấy tại https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# --- Google Gemini (AI chấm điểm bài đăng truyền thông) ---
# Lấy key tại https://aistudio.google.com/apikey
# LƯU Ý: key này CHỈ nằm ở backend, không bao giờ gửi xuống trình duyệt.
GEMINI_API_KEY=<gemini-api-key>
# Để trống sẽ dùng mặc định "gemini-flash-latest" (tự trỏ bản Flash mới nhất)
GEMINI_MODEL=gemini-flash-latest

# --- AWS (S3 lưu ảnh + Rekognition chấm công khuôn mặt) ---
AWS_ACCESS_KEY=<aws-access-key>
AWS_SECRET_KEY=<aws-secret-key>
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=trilong-kpi-uploads
AWS_S3_BASE_URL=https://trilong-kpi-uploads.s3.ap-southeast-1.amazonaws.com

# ------------------------------------------------------------
# (TUỲ CHỌN) Chạy KHÔNG phụ thuộc AWS thật:
#   - Lưu ảnh vào container thay vì S3
#   - Tắt tính năng chấm công bằng khuôn mặt
# Bỏ comment 2 dòng dưới. LƯU Ý: vẫn phải điền AWS_ACCESS_KEY/AWS_SECRET_KEY
# một giá trị BẤT KỲ khác rỗng (vd: dummy) vì bean khởi tạo client luôn
# yêu cầu key, dù không thực sự gọi AWS.
# APP_STORAGE_TYPE=local
# APP_REKOGNITION_ENABLED=false
